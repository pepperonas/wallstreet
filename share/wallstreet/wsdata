    return 1


def cmd_marquee(color, delay, text):
    text = re.sub(r"\s+", " ", clean(text)).strip()
    if not text:
        return 1
    code = COLORS.get(color, 37)
    delay = float(delay)
    cols = max(10, term_size().columns - 1)
    band = " " * cols + text + " " * cols
    try:
        sys.stdout.write("\033[?25l")
        for i in range(len(band) - cols + 1):
            cols_now = max(10, term_size().columns - 1)
            sys.stdout.write("\r\033[1;%dm%s\033[0m\033[K" % (
                code, band[i:i + cols][:cols_now]))
            sys.stdout.flush()
            time.sleep(delay)
    finally:
        sys.stdout.write("\033[?25h\r")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "table":
        return cmd_table()
    if cmd == "movers" and len(argv) > 2:
        return cmd_movers(argv[2])
    if cmd == "headlines":
        return cmd_headlines()
    if cmd == "image":
        return cmd_image()
    if cmd == "browse":
        return cmd_browse()
    if cmd == "chart":
        return cmd_chart()
    if cmd == "demofeed":
        return cmd_demofeed()
    if cmd == "cachedir":
        print(CACHE)
        return 0
    if cmd == "marquee" and len(argv) > 4:
        return cmd_marquee(argv[2], argv[3], argv[4])
    sys.stderr.write(__doc__ or "usage: wsdata table|movers|headlines|image|marquee\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(130)
