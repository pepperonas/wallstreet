BRAILLE = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))   # [row][column] of a cell


def plot(points, width, height, low=None, high=None):
    """The course as HEIGHT strings of WIDTH braille characters (2x4 dots per cell).

    LOW and HIGH widen the value range, for a reference line outside the course."""
    dots_w, dots_h = width * 2, height * 4
    low = min(points) if low is None else min(low, min(points))
    high = max(points) if high is None else max(high, max(points))
    spread = (high - low) or 1.0
    ys = []
    for x in range(dots_w):
        # straight lines between the points: 22 daily closes on 180 dots would be stairs
        at = x * (len(points) - 1) / max(1, dots_w - 1)
        i = min(len(points) - 2, int(at))
        value = points[i] + (points[i + 1] - points[i]) * (at - i)
        ys.append(int(round((high - value) / spread * (dots_h - 1))))
    cells = [[0] * width for _ in range(height)]
    for x, y in enumerate(ys):
        prev = ys[x - 1] if x else y
        for dot in range(min(prev, y), max(prev, y) + 1):      # close the gaps of steep moves
            cells[dot // 4][x // 2] |= BRAILLE[dot % 4][x % 2]
    return ["".join(chr(0x2800 + c) if c else " " for c in line) for line in cells]


def price(value):
    return "%.2f" % value if abs(value) < 100000 else "%.0f" % value


TAB_ROW = 3            # the line of the chart pane that holds the span tabs, 1-based
TAB_GAP = 2


def tab_cells():
    """Per span the 1-based columns of its tab, as drawn by chart_lines."""
    cells, x = {}, 1
    for key, label in SPANS:
        cells[key] = range(x, x + len(label) + 2)
        x += len(label) + 2 + TAB_GAP
    return cells


def tab_at(x, y):
    """The span whose tab is at cell (x, y) of the chart pane, or None."""
    if y != TAB_ROW:
        return None
    return next((key for key, cells in tab_cells().items() if x in cells), None)


def chart_lines(data, span, cols, lines):
    """The chart pane as a list of at most LINES strings no wider than COLS - 1."""
    width = max(20, cols - 1)
    tabs = (" " * TAB_GAP).join(("\033[7m %s \033[27m" if key == span else " %s ") % label
                                for key, label in SPANS)
    out = []
    if not data:
        symbol = read_selection()[0]
        out.append("\033[1;34m%s\033[0m" % symbol if symbol else "\033[1;33mCHART\033[0m")
        out.append("")                     # keeps the tabs on TAB_ROW, where a click looks for them
        out.append("\033[90m%s\033[0m" % tabs)
        out.append("")
        out.append("\033[33m%s\033[0m" % (
            "No chart data for this symbol right now." if symbol
            else "Select a stock: click a row or use the arrow keys.")[:width])
        return out[:lines]
    reference = data.get("reference")
    change = data["last"] - reference if reference is not None else 0.0
    colour = "32" if change >= 0 else "31"
    name_w = max(0, width - len(data["symbol"]) - 1)
    out.append("\033[1;34m%s\033[0m %s" % (data["symbol"], data["name"][:name_w]))
    head, plain = "\033[1;35m%s\033[0m" % price(data["last"]), price(data["last"])
    if reference:
        text = " %+.2f  %+.2f%%" % (change, change / reference * 100)
        head, plain = head + "\033[1;%sm%s\033[0m" % (colour, text), plain + text
    extended = data.get("extended")
    if extended:
        text = "  %s %s %+.2f (%+.2f%%)" % (extended["label"], price(extended["last"]),
                                            extended["change"], extended["pct"])
        if len(plain) + len(text) <= width:
            head += "\033[90m%s\033[0m" % text
    out.append(head)
    out.append("\033[90m%s\033[0m" % tabs)
    height = lines - 5
    points = data["points"]
    marked = reference if data.get("reference_line") and reference is not None else None
    low = min(points) if marked is None else min(marked, min(points))
    high = max(points) if marked is None else max(marked, max(points))
    axis = max(len(price(low)), len(price(high))) + 1
    plot_w = width - axis
    if height < 3 or plot_w < 10:
        return out[:lines]
    # the session in the colour of the day's result, trading outside it in grey
    dim_from = data.get("dim_from")
    dim_col = plot_w if dim_from is None else int(dim_from * plot_w / len(points))
    mark_row = None
    if marked is not None:
        mark_row = int(round((high - marked) / ((high - low) or 1.0) * (height * 4 - 1))) // 4
    labels = {0: price(high), height - 1: price(low), height // 2: price((high + low) / 2)}
    if mark_row is not None:
        # the reference takes the place of a neighbouring label instead of crowding it
        for row in (mark_row - 1, mark_row + 1):
            if row in labels and row not in (0, height - 1):
                del labels[row]
        labels[mark_row] = price(marked)
    for i, row in enumerate(plot(points, plot_w, height, low, high)):
        session, rest = row[:dim_col], row[dim_col:]
        if i == mark_row:
            # previous close: a dotted grey line wherever the course leaves room
            dotted = lambda part, c: "".join(
                "\033[90m\u2508\033[%sm" % c if ch == " " else ch for ch in part)
            session, rest = dotted(session, colour), dotted(rest, "90")
        out.append("\033[%sm%s\033[90m%s%*s\033[0m" % (colour, session, rest, axis, labels.get(i, "")))
    left, right = data["labels"]
    gap = max(1, plot_w - len(left) - len(right))
    out.append("\033[90m%s%s%s\033[0m" % (left, " " * gap, right)[:width + 9])
    return out[:lines]


# ---------------------------------------------------------------- terminal

class Terminal:
    """Keys and mouse clicks from the pane, without waiting for Enter.

    cbreak keeps Ctrl-C a signal, so the widget's trap still ends the show.
    Mouse reporting needs "mouse on" in tmux; without it the keys still work.
    """
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = None
        self.buffer = ""

    def __enter__(self):
        if os.isatty(self.fd):
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            sys.stdout.write("\033[?1000h\033[?1006h\033[?25l")
            sys.stdout.flush()
        return self

    def __exit__(self, *exc):
        if self.saved is not None:
            sys.stdout.write("\033[?1000l\033[?1006l\033[?25h")
            sys.stdout.flush()
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        return False

    def events(self, timeout):
        """Wait up to TIMEOUT seconds; return what was pressed or clicked."""
        if self.saved is None:
            time.sleep(timeout)
            return []
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if ready:
            self.buffer += os.read(self.fd, 256).decode("utf-8", "replace")
        events, self.buffer = parse_input(self.buffer)
        return events


def parse_input(buffer):
    """Split raw terminal input into events; an unfinished sequence stays in the rest.

    Events: ("key", name) for up/down/enter/escape or a single character,
            ("click", x, y) with 1-based cell coordinates, ("wheel", -1 | +1).
    """
    events = []
    while buffer:
        m = re.match(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", buffer)
        if m:
            button, x, y, kind = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
            if button in (64, 65):
                events.append(("wheel", -1 if button == 64 else 1))
            elif kind == "M" and button & 3 == 0 and button < 32:
                events.append(("click", x, y))
            buffer = buffer[m.end():]
            continue
        m = re.match(r"\x1b(?:\[|O)([A-D])", buffer)
        if m:
            events.append(("key", {"A": "up", "B": "down", "C": "right", "D": "left"}[m.group(1)]))
            buffer = buffer[m.end():]
            continue
        if buffer[0] == "\x1b":
            if re.fullmatch(r"\x1b(\[<?[\d;]*)?", buffer):
                break                      # the rest of the sequence has not arrived yet
            m = re.match(r"\x1b\[[\d;?<]*[A-Za-z~]", buffer)
            if m:
                buffer = buffer[m.end():]  # a sequence this program has no use for
                continue
            events.append(("key", "escape"))
            buffer = buffer[1:]
            continue
        events.append(("key", "enter" if buffer[0] in "\r\n" else buffer[0]))
        buffer = buffer[1:]
    return events, buffer


def draw(lines):
    """Replace the pane's content without the flicker of a clear."""
    sys.stdout.write("\033[H" + "".join(line + "\033[K\n" for line in lines[:-1])
                     + (lines[-1] + "\033[K" if lines else "") + "\033[J")
    sys.stdout.flush()


