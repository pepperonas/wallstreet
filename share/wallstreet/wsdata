def png_pixels(data, limit=1024):
    """Decode a PNG into (width, height, rows of (r, g, b, a)).  Standard library only;
    up to 8 bits a channel, not interlaced - which is what logos are.  Anything else
    raises ValueError."""
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    pos, idat, palette, alpha, head = 8, [], None, b"", None
    while pos + 8 <= len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        chunk = data[pos + 8:pos + 8 + length]
        pos += 12 + length
        if kind == b"IHDR":
            head = struct.unpack(">IIBBBBB", chunk)
        elif kind == b"PLTE":
            palette = chunk
        elif kind == b"tRNS":
            alpha = chunk
        elif kind == b"IDAT":
            idat.append(chunk)
        elif kind == b"IEND":
            break
    if not head:
        raise ValueError("no header")
    width, height, depth, colour, _, _, interlace = head
    channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(colour)
    packed = depth in (1, 2, 4) and colour in (0, 3)       # several pixels in one byte
    if not (depth == 8 or packed) or interlace or not channels \
            or not (0 < width <= limit and 0 < height <= limit):
        raise ValueError("unsupported PNG")
    stride = (width * channels * depth + 7) // 8
    unpack = zlib.decompressobj()
    raw = unpack.decompress(b"".join(idat), (stride + 1) * height)
    if len(raw) < (stride + 1) * height:
        raise ValueError("short PNG")
    rows, prev = [], bytearray(stride)
    for y in range(height):
        kind = raw[y * (stride + 1)]
        line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            left = line[i - channels] if i >= channels else 0
            up = prev[i]
            corner = prev[i - channels] if i >= channels else 0
            if kind == 1:
                line[i] = (line[i] + left) & 255
            elif kind == 2:
                line[i] = (line[i] + up) & 255
            elif kind == 3:
                line[i] = (line[i] + (left + up) // 2) & 255
            elif kind == 4:
                guess = left + up - corner
                a, b, c = abs(guess - left), abs(guess - up), abs(guess - corner)
                line[i] = (line[i] + (left if a <= b and a <= c else up if b <= c else corner)) & 255
        prev = line
        if packed:
            # unpack to one byte a pixel; greys are spread over 0-255
            mask, spread = (1 << depth) - 1, (255 // ((1 << depth) - 1) if colour == 0 else 1)
            line = bytearray(((line[(x * depth) // 8] >> (8 - depth - (x * depth) % 8)) & mask) * spread
                             for x in range(width))
        row = []
        for x in range(width):
            px = line[x * channels:(x + 1) * channels]
            if colour == 6:
                row.append(tuple(px))
            elif colour == 2:
                row.append((px[0], px[1], px[2], 255))
            elif colour == 0:
                row.append((px[0], px[0], px[0], 255))
            elif colour == 4:
                row.append((px[0], px[0], px[0], px[1]))
            else:
                i = px[0]
                if not palette or i * 3 + 2 >= len(palette):
                    raise ValueError("bad palette")
                row.append((palette[i * 3], palette[i * 3 + 1], palette[i * 3 + 2],
                            alpha[i] if i < len(alpha) else 255))
        rows.append(row)
    return width, height, rows


def tile(image, size, margin=2):
    """The picture, scaled into a SIZE x SIZE tile of (r, g, b) on the tile's ground."""
    width, height, rows = image
    # a logo made for dark pages would vanish on the light tile: look at what it is drawn in
    light = weight = 0
    for row in rows[::max(1, height // 32)]:
        for r, g, b, a in row[::max(1, width // 32)]:
            light, weight = light + (299 * r + 587 * g + 114 * b) // 1000 * a, weight + a
    # ... unless it brings a ground of its own (opaque corners)
    framed = min(rows[0][0][3], rows[0][-1][3], rows[-1][0][3], rows[-1][-1][3]) > 200
    ground = TILE_DARK if weight and light / weight > 200 and not framed else TILE
    inner = max(1, size - 2 * margin)
    scale = max(width, height) / float(inner)
    out_w, out_h = max(1, int(round(width / scale))), max(1, int(round(height / scale)))
    grid = [[ground] * size for _ in range(size)]
    off_x, off_y = (size - out_w) // 2, (size - out_h) // 2
    if scale < 1:
        # enlarging: blend the four neighbours, or a small logo becomes a mosaic
        for y in range(out_h):
            fy = min(height - 1.0, max(0.0, (y + 0.5) * scale - 0.5))
            y0 = int(fy); y1 = min(height - 1, y0 + 1); wy = fy - y0
            for x in range(out_w):
                fx = min(width - 1.0, max(0.0, (x + 0.5) * scale - 0.5))
                x0 = int(fx); x1 = min(width - 1, x0 + 1); wx = fx - x0
                r = g = b = a = 0.0
                for (pr, pg, pb, pa), wgt in ((rows[y0][x0], (1 - wx) * (1 - wy)), (rows[y0][x1], wx * (1 - wy)),
                                               (rows[y1][x0], (1 - wx) * wy), (rows[y1][x1], wx * wy)):
                    r, g, b, a = r + pr * pa * wgt, g + pg * pa * wgt, b + pb * pa * wgt, a + pa * wgt
                cover = a / 255.0
                grid[off_y + y][off_x + x] = tuple(
                    int(round((c / a if a else 0) * cover + gr * (1 - cover))) for c, gr in zip((r, g, b), ground))
        return grid
    for y in range(out_h):
        for x in range(out_w):
            # average over the block of source pixels this pixel stands for
            x0, x1 = int(x * scale), max(int(x * scale) + 1, min(width, int((x + 1) * scale)))
            y0, y1 = int(y * scale), max(int(y * scale) + 1, min(height, int((y + 1) * scale)))
            r = g = b = a = n = 0
            for sy in range(y0, min(y1, height)):
                for sx in range(x0, min(x1, width)):
                    pr, pg, pb, pa = rows[sy][sx]
                    r, g, b, a, n = r + pr * pa, g + pg * pa, b + pb * pa, a + pa, n + 1
            if not n:
                continue
            cover = a / (255.0 * n)
            mix = lambda c, ground: int(round((c / a if a else 0) * cover + ground * (1 - cover)))
            grid[off_y + y][off_x + x] = (mix(r, ground[0]), mix(g, ground[1]), mix(b, ground[2]))
    return grid


def monogram(symbol, size):
    """A tile with the first two letters of the symbol, in a colour of its own."""
    letters = [c for c in symbol.upper() if c in FONT][:2] or ["X"]
    hue = zlib.crc32(symbol.encode()) % 360
    # one of twelve calm colours; the letters in white
    c, x = 0.55, 0.55 * (1 - abs((hue / 60.0) % 2 - 1))
    r, g, b = [(c, x, 0), (x, c, 0), (0, c, x), (0, x, c), (x, 0, c), (c, 0, x)][hue // 60]
    ground = tuple(int((v + 0.18) * 255) for v in (r, g, b))
    scale = max(1, (size - 4) // (len(letters) * 6 - 1))
    text_w, text_h = (len(letters) * 6 - 1) * scale, 7 * scale
    grid = [[ground] * size for _ in range(size)]
    off_x, off_y = (size - text_w) // 2, (size - text_h) // 2
    for n, letter in enumerate(letters):
        for gy, bits in enumerate(FONT[letter].split()):
            for gx, bit in enumerate(bits):
                if bit == "1":
                    for dy in range(scale):
                        for dx in range(scale):
                            py, px = off_y + gy * scale + dy, off_x + (n * 6 + gx) * scale + dx
                            if 0 <= py < size and 0 <= px < size:
                                grid[py][px] = (255, 255, 255)
    return grid


NO_LOGO = set()      # symbols neither source had a picture for, so each is asked once


GRIDS = {}           # (symbol, size) -> tile: decoding and scaling 512 px takes a moment


def logo_grid(symbol, size):
    """The company's logo as a tile, or its monogram if there is none to be had."""
    if (symbol, size) not in GRIDS:
        if len(GRIDS) > 24:
            GRIDS.clear()
        GRIDS[(symbol, size)] = _logo_grid(symbol, size)
    return GRIDS[(symbol, size)]


def _logo_grid(symbol, size):
    if not DEMO and SYMBOL.fullmatch(symbol or "") and symbol not in NO_LOGO:
        for n, url in enumerate((LOGO_ISIN_URL,) if is_isin(symbol) else LOGO_URLS):
            name = "logo-%s-%s.png" % (urllib.parse.urlsplit(url).hostname, re.sub(r"[^A-Za-z0-9]", "_", symbol))
            data = cached(name, 30 * 86400, lambda: fetch(url % urllib.parse.quote(symbol, safe=""), timeout=6))
            try:
                return tile(png_pixels(data), size)
            except (ValueError, struct.error, zlib.error, IndexError):
                try:
                    os.unlink(os.path.join(CACHE, name))    # not a picture: do not keep it
                except OSError:
                    pass
        NO_LOGO.add(symbol)
    return monogram(label(symbol) if symbol else "?", size)


def colour256(rgb):
    """The nearest of the 216 cube colours and 24 greys every terminal has."""
    r, g, b = rgb
    if max(r, g, b) - min(r, g, b) < 12:
        grey = (r + g + b) // 3
        return 16 if grey < 5 else 231 if grey > 246 else 232 + min(23, (grey - 8) // 10)
    step = lambda v: 0 if v < 48 else 1 if v < 115 else (v - 35) // 40
    return 16 + 36 * step(r) + 6 * step(g) + step(b)


def logo_lines(symbol, cols, lines, rgb=False):
    """The logo pane in characters: the tile, centred, and the symbol below it."""
    size = max(8, min(cols - 2, (lines - 2) * 2) // 2 * 2)
    grid = logo_grid(symbol, size)
    pad = " " * max(0, (cols - 1 - size) // 2)
    out = [""] * max(0, (lines - 2 - size // 2) // 2)
    for y in range(0, size, 2):
        row, last = [], None
        for x in range(size):
            if rgb:
                pair = grid[y][x] + grid[y + 1][x]
            else:
                pair = (colour256(grid[y][x]), colour256(grid[y + 1][x]))
            if pair != last:
                row.append(("\033[38;2;%d;%d;%d;48;2;%d;%d;%dm" if rgb else "\033[38;5;%d;48;5;%dm") % pair)
                last = pair
            row.append("▀")                   # upper half block: top pixel fg, bottom pixel bg
        out.append(pad + "".join(row) + "\033[0m")
    out.append("")
    out.append(logo_caption(symbol, cols))
    return out[:lines]


def logo_caption(symbol, cols):
    symbol = label(symbol)
    return "\033[1;34m%s\033[0m" % (" " * max(0, (cols - 1 - len(symbol)) // 2) + symbol)


def sixel(grid):
    """The tile as a sixel picture: real pixels, for terminals that draw them."""
    height, width = len(grid), len(grid[0])
    # at most 255 colours: 5 bits a channel, and the rarest go to their nearest neighbour
    key = lambda px: (px[0] >> 3, px[1] >> 3, px[2] >> 3)
    count = {}
    for row in grid:
        for px in row:
            k = key(px)
            count[k] = count.get(k, 0) + 1
    kept = sorted(count, key=count.get, reverse=True)[:255]
    index = {k: n for n, k in enumerate(kept)}
    for k in count:
        if k not in index:
            index[k] = index[min(kept, key=lambda c: sum((a - b) ** 2 for a, b in zip(c, k)))]
    out = ['\033P0;1;0q"1;1;%d;%d' % (width, height)]
    for k, n in ((k, index[k]) for k in kept):
        out.append("#%d;2;%d;%d;%d" % ((n,) + tuple((c * 8 + 4) * 100 // 255 for c in k)))
    for top in range(0, height, 6):
        bands = {}
        for bit, row in enumerate(grid[top:top + 6]):
            for x, px in enumerate(row):
                n = index[key(px)]
                line = bands.get(n)
                if line is None:
                    line = bands[n] = [0] * width
                line[x] |= 1 << bit
        parts = []
        for n, line in bands.items():
            run, cells = None, []
            for v in line + [None]:
                if run and v == run[0]:
                    run[1] += 1
                    continue
                if run:
                    ch = chr(63 + run[0])
                    cells.append(ch * run[1] if run[1] < 4 else "!%d%s" % (run[1], ch))
                run = [v, 1]
            parts.append("#%d%s" % (n, "".join(cells)))
        out.append("$".join(parts) + "-")
    out.append("\033\\")
    return "".join(out)


def cell_pixels():
    """Width and height of a character cell in pixels as the terminal reports them, or (0, 0)."""
    import fcntl
    import termios
    for fd in (2, 0, 1):
        try:
            rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
        except (OSError, struct.error):
            continue
        if rows and cols and xpx and ypx:
            return xpx // cols, ypx // rows
    return 0, 0


def graphics():
    """How the logo can be drawn here: ("sixel", cell width, cell height), ("rgb",) or ("256",).
    WALLSTREET_LOGO=blocks forces characters, =sixel forces pixels."""
    want = os.environ.get("WALLSTREET_LOGO", "")
    rgb = os.environ.get("COLORTERM", "") in ("truecolor", "24bit")
    pane = os.environ.get("TMUX_PANE")
    if os.environ.get("TMUX") and pane:
        # inside tmux the clients decide: every terminal looking at this pane must be able to
        try:
            session = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{session_id}"],
                                     capture_output=True, text=True, timeout=3).stdout.strip()
            clients = [l.split("|") for l in subprocess.run(
                ["tmux", "list-clients", "-t", session, "-F",
                 "#{client_termfeatures}|#{client_cell_width}|#{client_cell_height}"],
                capture_output=True, text=True, timeout=3).stdout.splitlines() if l.count("|") == 2]
        except (OSError, subprocess.SubprocessError):
            clients = []
        feats = [set(c[0].split(",")) for c in clients]
        rgb = bool(feats) and all("RGB" in f for f in feats)
        cells = [(int(c[1] or 0), int(c[2] or 0)) for c in clients if c[1].isdigit() and c[2].isdigit()]
        if want != "blocks" and feats and all("sixel" in f for f in feats) \
                and len(cells) == len(clients) and all(w > 0 and h > 0 for w, h in cells):
            return ("sixel", min(w for w, _ in cells), min(h for _, h in cells))
        if want == "sixel":
            return ("sixel", 10, 20)      # asked for: a guess at the cell, when no client reports one
    elif want != "blocks" and (want == "sixel" or os.environ.get("TERM_PROGRAM") in ("iTerm.app", "WezTerm")):
        width, height = cell_pixels()
        if width and height:
            return ("sixel", width, height)
    return ("rgb",) if rgb else ("256",)


def logo_screen(symbol, cols, lines, mode):
    """What to write to show the logo: a picture where the terminal draws pixels,
    half blocks elsewhere."""
    if mode[0] != "sixel":
        lines_ = logo_lines(symbol, cols, lines, rgb=mode[0] == "rgb")
        return "\033[H" + "".join(l + "\033[K\n" for l in lines_[:-1]) + lines_[-1] + "\033[K\033[J"
    cell_w, cell_h = mode[1], mode[2]
    # a square of whole cells, never larger than a logo is delivered
    side = min((cols - 2) * cell_w, (lines - 2) * cell_h, 512 + 64)
    side = max(cell_h, side // cell_h * cell_h)
    used_cols, used_rows = -(-side // cell_w), side // cell_h
    top = max(0, (lines - 2 - used_rows) // 2)
    left = max(0, (cols - used_cols) // 2)
    picture = sixel(logo_grid(symbol, side))
    return ("\033[H\033[J\033[%d;%dH" % (top + 1, left + 1) + picture
            + "\033[%d;1H" % min(lines, top + used_rows + 2) + logo_caption(symbol, cols))


def cmd_logo():
    """The logo of the selected stock; follows the selection file."""
    seen, mode, tick = None, ("256",), 0
    sys.stdout.write("\033[?25l")
    try:
        while True:
            if tick % 10 == 0:
                mode = graphics()         # a terminal may attach later, or another one
            tick += 1
            now = (read_selection()[0], tuple(term_size()), mode)
            if now != seen:
                seen = now
                if now[0]:
                    sys.stdout.write(logo_screen(now[0], now[1][0], now[1][1], mode))
                    sys.stdout.flush()
                else:
                    draw(["", "\033[90m%s\033[0m" % "Select a stock."])
            time.sleep(0.3)
    finally:
        sys.stdout.write("\033[?25h")
    return 0


# ---------------------------------------------------------------- terminal

class Terminal:
    """Keys and mouse clicks from the pane, without waiting for Enter.

    cbreak keeps Ctrl-C a signal, so the widget's trap still ends the show.
    Mouse reporting needs "mouse on" in tmux; without it the keys still work.
    """
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = None
        self.buffer = ""

    def __enter__(self):
        if os.isatty(self.fd):
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            sys.stdout.write("\033[?1000h\033[?1006h\033[?25l")
            sys.stdout.flush()
        return self

    def __exit__(self, *exc):
        if self.saved is not None:
            sys.stdout.write("\033[?1000l\033[?1006l\033[?25h")
            sys.stdout.flush()
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        return False

    def events(self, timeout):
        """Wait up to TIMEOUT seconds; return what was pressed or clicked."""
        if self.saved is None:
            time.sleep(timeout)
            return []
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if ready:
            self.buffer += os.read(self.fd, 256).decode("utf-8", "replace")
        # an ESC that is still alone after a moment is the key, not a sequence
        final = self.buffer == "\x1b" and not select.select([self.fd], [], [], 0.05)[0]
        events, self.buffer = parse_input(self.buffer, final)
        return events


def parse_input(buffer, final=False):
    """Split raw terminal input into events; an unfinished sequence stays in the rest.

    Events: ("key", name) for up/down/left/right/enter/escape/backspace/delete or a
            single character, ("click", x, y) with 1-based cell coordinates,
            ("wheel", -1 | +1).
    FINAL says that nothing more is coming for now: a lone ESC is then the Escape key
    and not the start of a sequence.
    """
    events = []
    while buffer:
        m = re.match(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", buffer)
        if m:
            button, x, y, kind = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
            if button in (64, 65):
                events.append(("wheel", -1 if button == 64 else 1))
            elif kind == "M" and button & 3 == 0 and button < 32:
                events.append(("click", x, y))
            buffer = buffer[m.end():]
            continue
        m = re.match(r"\x1b(?:\[|O)([A-D])", buffer)
        if m:
            events.append(("key", {"A": "up", "B": "down", "C": "right", "D": "left"}[m.group(1)]))
            buffer = buffer[m.end():]
            continue
        if buffer.startswith("\x1b[3~"):
            events.append(("key", "delete"))
            buffer = buffer[4:]
            continue
        if buffer[0] == "\x1b":
            if re.fullmatch(r"\x1b(\[<?[\d;]*)?", buffer):
                if final and buffer == "\x1b":
                    events.append(("key", "escape"))
                    buffer = ""
                break                      # the rest of the sequence has not arrived yet
            m = re.match(r"\x1b\[[\d;?<]*[A-Za-z~]", buffer)
            if m:
                buffer = buffer[m.end():]  # a sequence this program has no use for
                continue
            events.append(("key", "escape"))
            buffer = buffer[1:]
            continue
        events.append(("key", "enter" if buffer[0] in "\r\n" else
                       "backspace" if buffer[0] in "\x7f\x08" else buffer[0]))
        buffer = buffer[1:]
    return events, buffer


def draw(lines):
    """Replace the pane's content without the flicker of a clear."""
    sys.stdout.write("\033[H" + "".join(line + "\033[K\n" for line in lines[:-1])
                     + (lines[-1] + "\033[K" if lines else "") + "\033[J")
    sys.stdout.flush()


