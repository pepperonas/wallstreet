SECTIONS = (("MOST ACTIVE", "MostActiveByDollarVolume"), ("NASDAQ-100 MOVERS", "Nasdaq100Movers"),
            ("ADVANCERS", "MostAdvanced"), ("DECLINERS", "MostDeclined"))
SYMBOL = re.compile(r"[A-Za-z0-9.^-]{1,12}")
WATCH_MAX = 12


# ---------------------------------------------------------------- watchlist
#
# Stocks found with the search are kept in a list of their own, above the day's
# movers, until they are removed again.

def watchlist_path():
    return os.path.join(CACHE, "watchlist-demo.json" if DEMO else "watchlist.json")


def read_watchlist():
    """[(symbol, name)], newest first; a damaged file is an empty list."""
    try:
        with open(watchlist_path(), encoding="utf-8") as f:
            data = json.load(f)
        out = []
        for item in data:
            symbol = clean(item.get("symbol", ""))
            if SYMBOL.fullmatch(symbol) and symbol not in [s for s, _ in out]:
                out.append((symbol, clean(item.get("name", ""))[:80]))
        return out[:WATCH_MAX]
    except (OSError, ValueError, AttributeError, TypeError):
        return []


def write_watchlist(items):
    fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump([{"symbol": s, "name": n} for s, n in items[:WATCH_MAX]], f)
    os.replace(tmp, watchlist_path())


def watch(symbol, name):
    """Put a stock at the top of the watchlist."""
    if SYMBOL.fullmatch(symbol or ""):
        write_watchlist([(symbol, name)] + [i for i in read_watchlist() if i[0] != symbol])


def unwatch(symbol):
    write_watchlist([i for i in read_watchlist() if i[0] != symbol])


def watch_rows():
    """The watchlist as table rows, with the quote of each stock."""
    out = []
    for symbol, name in read_watchlist():
        row = {"symbol": symbol, "name": name, "lastSalePrice": "", "lastSaleChange": "", "change": ""}
        if DEMO:
            found = next((r for key in ("MostActiveByDollarVolume", "Nasdaq100Movers")
                          for r in rows(key) if r.get("symbol") == symbol), None)
            if found:
                row = dict(found)
        else:
            q = quote(symbol)
            row["label"] = label(symbol)
            if q:
                row.update(lastSalePrice=price(q["last"]) + (" \u20ac" if q.get("currency") == "EUR" else ""),
                           lastSaleChange="%+.2f" % q["change"],
                           change="%+.2f%%" % q["pct"],
                           deltaIndicator="down" if q["change"] < 0 else "up")
        out.append(row)
    return out


# ------------------------------------------------------------------- search

def search(query):
    """Stocks and funds traded on an exchange whose symbol or name matches QUERY:
    [{"symbol", "name", "exchange"}], best match first, at most ten."""
    query = re.sub(r"\s+", " ", clean(query)).strip()[:40]
    if not query:
        return []
    if DEMO:
        q = query.lower()
        hits = [(sym, name) for sym, name, _ in DEMO_STOCKS if q in sym.lower() or q in name.lower()]
        hits.sort(key=lambda h: (not h[0].lower().startswith(q), h[0]))
        return [{"symbol": sym, "name": name, "exchange": "DEMO"} for sym, name in hits[:10]]
    url = "https://api.nasdaq.com/api/autocomplete/slookup/25?search=" + urllib.parse.quote(query, safe="")
    key = "search-%s.json" % re.sub(r"[^a-z0-9]", "_", query.lower())[:40]
    try:
        data = json.loads(cached(key, 3600, lambda: fetch(url)))["data"] or []
    except (ValueError, KeyError, TypeError):
        data = []
    out = []
    for item in data:
        try:
            symbol = clean(item.get("symbol") or "")
            # notes and mutual funds have no course to draw
            if item.get("asset") not in ("STOCKS", "ETF") or not SYMBOL.fullmatch(symbol):
                continue
            out.append({"symbol": symbol, "name": clean(item.get("name") or symbol),
                        "exchange": clean(item.get("exchange") or "")[:12]})
        except AttributeError:
            continue
    # what is not listed in the US - and the euro price of what is - from Lang & Schwarz;
    # both get their share of the ten lines
    # that search wants the name as the exchange writes it ("mercedes-benz"); a name typed
    # with spaces is tried with hyphens and then by its first word
    elsewhere = []
    for variant in dict.fromkeys((query, query.replace(" ", "-"), query.split(" ")[0])):
        elsewhere = ls_search(variant)
        if elsewhere:
            break
    room = max(10 - len(elsewhere), 5)
    return (out[:room] + elsewhere)[:10]


def search_lines(query, results, index, cols, lines, waiting=False):
    """The search view as LINES strings; result I is on line 3 + I (1-based)."""
    width = max(20, cols - 1)
    out = ["\033[1;33mSEARCH\033[0m", "\033[90m%s\033[0m" % ("-" * width)]
    room = max(0, lines - 4)
    name_w = max(8, width - 21)
    for i, r in enumerate(results[:room]):
        text = "\033[1;34m%-6s\033[39;22m %-*s \033[90m%12s\033[39m" % (
            (r.get("label") or r["symbol"])[:6], name_w, r["name"][:name_w], r["exchange"][:12])
        out.append("\033[48;5;238m%s\033[K\033[0m" % text if i == index else text + "\033[0m")
    if not results:
        note = ("Type a name or a symbol." if not query else
                "searching ..." if waiting else "Nothing found for \"%s\"." % query)
        out.append("\033[90m%s\033[0m" % note[:width])
    out += [""] * max(0, lines - 2 - len(out))
    out.append("\033[1;33msearch:\033[0m %s\033[7m \033[27m" % query[:max(0, width - 10)])
    out.append("\033[90m%s\033[0m" % "enter add to watchlist · ↑↓ choose · esc back"[:width])
    return out[:lines]


# -------------------------------------------------------------------- table

def table_rows(cols, lines):
    """The quote table as [(text, symbol or None, section)], cut to LINES like cmd_table."""
    out = []
    name_w = max(8, cols - 42)
    sections = [("WATCHLIST", "watch", watch_rows())]
    sections += [("INDEX MOVERS" if DEMO and key == "Nasdaq100Movers" else title, key, rows(key))
                 for title, key in SECTIONS]
    for title, key, data in sections:
        if not data:
            continue
        out.append(("\033[1;33m%s\033[0m" % title, None, key))
        out.append(("\033[90m%s\033[0m" % ("-" * (cols - 1)), None, key))
        for r in data:
            pct = percent(r)
            shown = "%+.2f%%" % pct if pct is not None else r.get("change", "")
            down = r.get("deltaIndicator") == "down" or shown.startswith("-")
            text = "\033[1;34m%-6s\033[39;22m %-*s \033[1;35m%10s\033[39;22m \033[1;%sm%10s %9s\033[39;22m" % (
                (r.get("label") or r.get("symbol", ""))[:6], name_w, r.get("name", "")[:name_w],
                r.get("lastSalePrice", "").lstrip("$")[:10],
                "31" if down else "32", r.get("lastSaleChange", "")[:10], shown[:9])
            out.append((text, r.get("symbol", ""), key))
        out.append(("", None, key))
    out = out[:max(3, lines)]
    while len(out) > 3 and out[-1][1] is None:
        out.pop()                           # no bare heading at the cut
    return out


def table_view(table, index, cols, lines):
    """The table pane: the rows with the selected one marked, and the hint line."""
    on_watchlist = bool(table) and index < len(table) and table[index][2] == "watch"
    hint = "click or ↑↓ select · / search · 1-5 span" + (" · d remove" if on_watchlist else "")
    view = [("\033[48;5;238m%s\033[K\033[0m" % text if i == index else text + "\033[0m")
            for i, (text, _, _) in enumerate(table)]
    view = view[:max(0, lines - 1)]              # the hint keeps its line, whatever the table
    view += [""] * max(0, lines - 1 - len(view))
    view.append("\033[90m%s\033[0m" % hint[:max(0, cols - 1)])
    return view


def cmd_browse():
    """The quote table with a selection - arrow keys, j/k, mouse wheel or a click -
    and a search: "/" or a click on the hint line."""
    with Terminal() as term:
        table, shown, size, loaded, index = [], None, None, 0.0, 0
        query, results, at_result, searched = None, [], 0, None      # query is None: not searching
        while True:
            now_size = tuple(term_size())
            if now_size != size or time.time() - loaded >= 60:
                size, loaded = now_size, time.time()
                table = table_rows(size[0], size[1] - 2)
                picks = [i for i, row in enumerate(table) if row[1]]
                wanted = read_selection()[0]
                index = next((i for i in picks if table[i][1] == wanted), picks[0] if picks else 0)
                shown = None
            picks = [i for i, row in enumerate(table) if row[1]]
            if query is not None:
                state = ("search", query, at_result, searched)
                if shown != state:
                    draw(search_lines(query, results, at_result, size[0], size[1], waiting=searched != query))
                    shown = state
            elif picks and shown != index:
                if table[index][1] != read_selection()[0]:
                    write_selection(symbol=table[index][1])
                draw(table_view(table, index, size[0], size[1]))
                shown = index
            elif not picks and shown != "empty":
                draw(["\033[33mNo market data available right now.\033[0m", "",
                      "\033[90m/ search\033[0m"])
                shown = "empty"
            events = term.events(0.5 if query is None else 0.25)
            if query is not None and not events and searched != query:
                results, searched, at_result = search(query), query, 0   # typing has paused: look it up
                continue
            for event in events:
                if query is not None:
                    chosen = None
                    if event == ("key", "escape"):
                        query, shown = None, None
                    elif event == ("key", "enter"):
                        if searched != query:
                            results, searched, at_result = search(query), query, 0
                        chosen = results[at_result] if results else None
                    elif event[0] == "click" and 0 <= event[2] - 3 < len(results):
                        chosen = results[event[2] - 3]
                    elif event[0] == "wheel" or event in (("key", "up"), ("key", "down")):
                        step = event[1] if event[0] == "wheel" else (-1 if event[1] == "up" else 1)
                        at_result = max(0, min(len(results) - 1, at_result + step))
                    elif event == ("key", "backspace"):
                        query = query[:-1]
                    elif event[0] == "key" and len(event[1]) == 1 and event[1].isprintable() and len(query) < 40:
                        query += event[1]
                    if chosen:
                        watch(chosen["symbol"], chosen["name"])
                        write_selection(symbol=chosen["symbol"])
                        query, shown, loaded = None, None, 0.0          # back to the table, reloaded
                    continue
                if event == ("key", "/") or event == ("key", "s") or \
                        (event[0] == "click" and event[2] == size[1]):
                    query, results, at_result, searched, shown = "", [], 0, "", None
                    continue
                if not picks:
                    continue
                at = picks.index(index) if index in picks else 0
                if event[0] == "click":
                    line = event[2] - 1
                    if line in picks:
                        index = line
                elif event[0] == "wheel" or event in (("key", "up"), ("key", "down"),
                                                       ("key", "k"), ("key", "j")):
                    step = event[1] if event[0] == "wheel" else (-1 if event[1] in ("up", "k") else 1)
                    index = picks[max(0, min(len(picks) - 1, at + step))]
                elif event[0] == "key" and event[1] in "12345":
                    write_selection(span=SPAN_KEYS[int(event[1]) - 1])
                elif event[0] == "key" and event[1] in ("d", "delete", "backspace") \
                        and table[index][2] == "watch":
                    unwatch(table[index][1])
                    loaded, shown = 0.0, None                            # reload without it
    return 0


def cmd_chart():
    """The chart of the selected stock; follows the selection file."""
    with Terminal() as term:
        seen, size, data, loaded = None, None, None, 0.0
        while True:
            selection, now_size = read_selection(), tuple(term_size())
            stale = time.time() - loaded >= 60
            if selection != seen and selection[0]:
                # say so at once: the first request for a symbol takes a moment
                draw(["\033[1;34m%s\033[0m" % selection[0], "\033[90mloading ...\033[0m"])
            if selection != seen or stale:
                data = history(selection[0], selection[1]) if selection[0] else None
                loaded = time.time()
            if selection != seen or now_size != size or stale:
                seen, size = selection, now_size
                draw(chart_lines(data, selection[1], size[0], size[1]) or [""])
            for event in term.events(0.25):
                keys = SPAN_KEYS
                if event[0] == "key" and event[1] in "12345":
                    write_selection(span=keys[int(event[1]) - 1])
                elif event[0] == "click" and tab_at(event[1], event[2]):
                    write_selection(span=tab_at(event[1], event[2]))      # a click on a tab opens it
                elif event[0] == "click" or event in (("key", "right"), ("key", "enter"), ("key", " ")):
                    write_selection(span=keys[(keys.index(selection[1]) + 1) % len(keys)])
                elif event == ("key", "left"):
                    write_selection(span=keys[(keys.index(selection[1]) - 1) % len(keys)])
    return 0


