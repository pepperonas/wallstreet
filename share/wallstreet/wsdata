def demo_history(symbol, span):
    """An invented course that ends at the symbol's current demo quote."""
    row = next((r for key in ("MostActiveByDollarVolume", "Nasdaq100Movers")
                for r in rows(key) if r.get("symbol") == symbol), None)
    base = next((b for sym, _, b in DEMO_STOCKS if sym == symbol), 100.0)
    name = next((n for sym, n, _ in DEMO_STOCKS if sym == symbol), symbol)
    last = float(row["lastSalePrice"].lstrip("$")) if row else base
    n = 390 if span == "1d" else {"1m": 22, "3m": 64, "1y": 252}[span]
    start = base if span == "1d" else base * {"1m": 0.94, "3m": 0.86, "1y": 0.7}[span]
    rnd = random.Random("%s/%s/%d" % (symbol, span, time.time() // 86400))
    walk, level = [], 0.0
    for _ in range(n):
        level += rnd.gauss(0, 1)
        walk.append(level)
    scale = max(abs(last - start), base * 0.012) / max(1e-9, max(abs(w) for w in walk)) * 0.9
    points = []
    for i, w in enumerate(walk):
        t = i / (n - 1)
        bridge = (w - walk[0] * (1 - t) - walk[-1] * t) * scale   # noise that is zero at both ends
        points.append(start + (last - start) * t + bridge)
    now = time.time()
    if span == "1d":
        labels = ("9:30 AM", "4:00 PM")
    else:
        days = dict((k, d) for k, _, d in SPANS)[span]
        labels = (time.strftime("%m/%d/%Y", time.localtime(now - days * 86400)),
                  time.strftime("%m/%d/%Y", time.localtime(now)))
    return {"symbol": symbol, "name": name, "points": points, "labels": labels,
            "last": last, "reference": base if span == "1d" else points[0]}


def history(symbol, span):
    """Course of one symbol: {symbol, name, points, labels, last, reference} or None."""
    if DEMO:
        return demo_history(symbol, span)
    days = dict((k, d) for k, _, d in SPANS)[span]
    query = ""
    if days:
        day = lambda t: time.strftime("%Y-%m-%d", time.gmtime(t))
        query = "&fromdate=%s&todate=%s" % (day(time.time() - days * 86400), day(time.time()))
    data = None
    for asset in ("stocks", "etf"):
        url = "https://api.nasdaq.com/api/quote/%s/chart?assetclass=%s%s" % (
            urllib.parse.quote(symbol, safe=""), asset, query)
        raw = cached("chart-%s-%s-%s.json" % (re.sub(r"[^A-Za-z0-9]", "_", symbol), span, asset),
                     60 if span == "1d" else 3600, lambda: fetch(url))
        try:
            data = json.loads(raw)["data"]
            if data and data.get("chart"):
                break
        except (ValueError, KeyError, TypeError):
            data = None
    if not data or not data.get("chart"):
        return None
    try:
        points = [float(p["y"]) for p in data["chart"]]
        number = lambda v: float(str(v).replace("$", "").replace(",", ""))
        last = number(data.get("lastSalePrice") or points[-1])
        reference = number(data["previousClose"]) if span == "1d" else points[0]
        labels = (clean(data["chart"][0]["z"]["dateTime"]), clean(data["chart"][-1]["z"]["dateTime"]))
    except (KeyError, TypeError, ValueError):
        return None
    if len(points) < 2:
        return None
    return {"symbol": symbol, "name": clean(data.get("company") or symbol), "points": points,
            "labels": labels, "last": last, "reference": reference}


# -------------------------------------------------------------------- chart

BRAILLE = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))   # [row][column] of a cell


def plot(points, width, height):
    """The course as HEIGHT strings of WIDTH braille characters (2x4 dots per cell)."""
    dots_w, dots_h = width * 2, height * 4
    low, high = min(points), max(points)
    spread = (high - low) or 1.0
    ys = []
    for x in range(dots_w):
        # straight lines between the points: 22 daily closes on 180 dots would be stairs
        at = x * (len(points) - 1) / max(1, dots_w - 1)
        i = min(len(points) - 2, int(at))
        value = points[i] + (points[i + 1] - points[i]) * (at - i)
        ys.append(int(round((high - value) / spread * (dots_h - 1))))
    cells = [[0] * width for _ in range(height)]
    for x, y in enumerate(ys):
        prev = ys[x - 1] if x else y
        for dot in range(min(prev, y), max(prev, y) + 1):      # close the gaps of steep moves
            cells[dot // 4][x // 2] |= BRAILLE[dot % 4][x % 2]
    return ["".join(chr(0x2800 + c) if c else " " for c in line) for line in cells]


def price(value):
    return "%.2f" % value if abs(value) < 100000 else "%.0f" % value


def chart_lines(data, span, cols, lines):
    """The chart pane as a list of at most LINES strings no wider than COLS - 1."""
    width = max(20, cols - 1)
    tabs = "  ".join(("\033[7m %s \033[27m" if key == span else " %s ") % label
                     for key, label, _ in SPANS)
    out = []
    if not data:
        symbol = read_selection()[0]
        out.append("\033[1;34m%s\033[0m" % symbol if symbol else "\033[1;33mCHART\033[0m")
        out.append("\033[90m%s\033[0m" % tabs)
        out.append("")
        out.append("\033[33m%s\033[0m" % (
            "No chart data for this symbol right now." if symbol
            else "Select a stock: click a row or use the arrow keys.")[:width])
        return out[:lines]
    change = data["last"] - data["reference"]
    pct = change / data["reference"] * 100 if data["reference"] else 0.0
    colour = "32" if change >= 0 else "31"
    name_w = max(0, width - len(data["symbol"]) - 1)
    out.append("\033[1;34m%s\033[0m %s" % (data["symbol"], data["name"][:name_w]))
    out.append("\033[1;35m%s\033[0m \033[1;%sm%+.2f  %+.2f%%\033[0m" % (
        price(data["last"]), colour, change, pct))
    out.append("\033[90m%s\033[0m" % tabs)
    height = lines - 5
    low, high = min(data["points"]), max(data["points"])
    axis = max(len(price(low)), len(price(high))) + 1
    plot_w = width - axis
    if height < 3 or plot_w < 10:
        return out[:lines]
    for i, row in enumerate(plot(data["points"], plot_w, height)):
        label = price(high) if i == 0 else price(low) if i == height - 1 else \
            price((high + low) / 2) if i == height // 2 else ""
        out.append("\033[%sm%s\033[0m\033[90m%*s\033[0m" % (colour, row, axis, label))
    left, right = data["labels"]
    gap = max(1, plot_w - len(left) - len(right))
    out.append("\033[90m%s%s%s\033[0m" % (left, " " * gap, right)[:width + 9])
    return out[:lines]


# ---------------------------------------------------------------- terminal

class Terminal:
    """Keys and mouse clicks from the pane, without waiting for Enter.

    cbreak keeps Ctrl-C a signal, so the widget's trap still ends the show.
    Mouse reporting needs "mouse on" in tmux; without it the keys still work.
    """
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = None
        self.buffer = ""

    def __enter__(self):
        if os.isatty(self.fd):
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            sys.stdout.write("\033[?1000h\033[?1006h\033[?25l")
            sys.stdout.flush()
        return self

    def __exit__(self, *exc):
        if self.saved is not None:
            sys.stdout.write("\033[?1000l\033[?1006l\033[?25h")
            sys.stdout.flush()
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        return False

    def events(self, timeout):
        """Wait up to TIMEOUT seconds; return what was pressed or clicked."""
        if self.saved is None:
            time.sleep(timeout)
            return []
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if ready:
            self.buffer += os.read(self.fd, 256).decode("utf-8", "replace")
        events, self.buffer = parse_input(self.buffer)
        return events


def parse_input(buffer):
    """Split raw terminal input into events; an unfinished sequence stays in the rest.

    Events: ("key", name) for up/down/enter/escape or a single character,
            ("click", x, y) with 1-based cell coordinates, ("wheel", -1 | +1).
    """
    events = []
    while buffer:
        m = re.match(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", buffer)
        if m:
            button, x, y, kind = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
            if button in (64, 65):
                events.append(("wheel", -1 if button == 64 else 1))
            elif kind == "M" and button & 3 == 0 and button < 32:
                events.append(("click", x, y))
            buffer = buffer[m.end():]
            continue
        m = re.match(r"\x1b(?:\[|O)([A-D])", buffer)
        if m:
            events.append(("key", {"A": "up", "B": "down", "C": "right", "D": "left"}[m.group(1)]))
            buffer = buffer[m.end():]
            continue
        if buffer[0] == "\x1b":
            if re.fullmatch(r"\x1b(\[<?[\d;]*)?", buffer):
                break                      # the rest of the sequence has not arrived yet
            m = re.match(r"\x1b\[[\d;?<]*[A-Za-z~]", buffer)
            if m:
                buffer = buffer[m.end():]  # a sequence this program has no use for
                continue
            events.append(("key", "escape"))
            buffer = buffer[1:]
            continue
        events.append(("key", "enter" if buffer[0] in "\r\n" else buffer[0]))
        buffer = buffer[1:]
    return events, buffer


def draw(lines):
    """Replace the pane's content without the flicker of a clear."""
    sys.stdout.write("\033[H" + "".join(line + "\033[K\n" for line in lines[:-1])
                     + (lines[-1] + "\033[K" if lines else "") + "\033[J")
    sys.stdout.flush()


# ------------------------------------------------------------------- browse

SECTIONS = (("MOST ACTIVE", "MostActiveByDollarVolume"), ("NASDAQ-100 MOVERS", "Nasdaq100Movers"),
            ("ADVANCERS", "MostAdvanced"), ("DECLINERS", "MostDeclined"))


def table_rows(cols, lines):
    """The quote table as [(text, symbol or None)], cut to LINES like cmd_table."""
    out = []
    name_w = max(8, cols - 42)
    for title, key in SECTIONS:
        data = rows(key)
        if not data:
            continue
        if DEMO and key == "Nasdaq100Movers":
            title = "INDEX MOVERS"
        out.append(("\033[1;33m%s\033[0m" % title, None))
        out.append(("\033[90m%s\033[0m" % ("-" * (cols - 1)), None))
        for r in data:
            pct = percent(r)
            shown = "%+.2f%%" % pct if pct is not None else r.get("change", "")
            down = r.get("deltaIndicator") == "down" or shown.startswith("-")
            text = "\033[1;34m%-6s\033[39;22m %-*s \033[1;35m%10s\033[39;22m \033[1;%sm%10s %9s\033[39;22m" % (
                r.get("symbol", "")[:6], name_w, r.get("name", "")[:name_w],
                r.get("lastSalePrice", "").lstrip("$")[:10],
                "31" if down else "32", r.get("lastSaleChange", "")[:10], shown[:9])
            out.append((text, r.get("symbol", "")))
        out.append(("", None))
    out = out[:max(3, lines)]
    while len(out) > 3 and out[-1][1] is None:
        out.pop()                           # no bare heading at the cut
    return out


def cmd_browse():
    """The quote table with a selection: arrow keys, j/k, mouse wheel or a click."""
    with Terminal() as term:
        table, shown, size, loaded, index = [], None, None, 0.0, 0
        while True:
            now_size = tuple(term_size())
            if now_size != size or time.time() - loaded >= 60:
                size, loaded = now_size, time.time()
                table = table_rows(size[0], size[1] - 2)
                picks = [i for i, (_, sym) in enumerate(table) if sym]
                wanted = read_selection()[0]
                index = next((i for i in picks if table[i][1] == wanted), picks[0] if picks else 0)
                shown = None
            picks = [i for i, (_, sym) in enumerate(table) if sym]
            if picks and shown != index:
                if table[index][1] != read_selection()[0]:
                    write_selection(symbol=table[index][1])
                hint = "click or ↑↓ select · 1 2 3 4 span"
                view = [("\033[48;5;238m%s\033[K\033[0m" % text if i == index else text + "\033[0m")
                        for i, (text, _) in enumerate(table)]
                view += [""] * max(0, size[1] - 1 - len(view))
                view.append("\033[90m%s\033[0m" % hint[:max(0, size[0] - 1)])
                draw(view[:size[1]])
                shown = index
            elif not picks and shown != "empty":
                draw(["\033[33mNo market data available right now.\033[0m"])
                shown = "empty"
            for event in term.events(0.5):
                if not picks:
                    continue
                at = picks.index(index) if index in picks else 0
                if event[0] == "click":
                    line = event[2] - 1
                    if line in picks:
                        index = line
                elif event[0] == "wheel" or event in (("key", "up"), ("key", "down"),
                                                       ("key", "k"), ("key", "j")):
                    step = event[1] if event[0] == "wheel" else (-1 if event[1] in ("up", "k") else 1)
                    index = picks[max(0, min(len(picks) - 1, at + step))]
                elif event[0] == "key" and event[1] in "1234":
                    write_selection(span=SPANS[int(event[1]) - 1][0])
    return 0


def cmd_chart():
    """The chart of the selected stock; follows the selection file."""
    with Terminal() as term:
        seen, size, data, loaded = None, None, None, 0.0
        while True:
            selection, now_size = read_selection(), tuple(term_size())
            stale = time.time() - loaded >= 60
            if selection != seen and selection[0]:
                # say so at once: the first request for a symbol takes a moment
                draw(["\033[1;34m%s\033[0m" % selection[0], "\033[90mloading ...\033[0m"])
            if selection != seen or stale:
                data = history(selection[0], selection[1]) if selection[0] else None
                loaded = time.time()
            if selection != seen or now_size != size or stale:
                seen, size = selection, now_size
                draw(chart_lines(data, selection[1], size[0], size[1]) or [""])
            for event in term.events(0.25):
                keys = [k for k, _, _ in SPANS]
                if event[0] == "key" and event[1] in "1234":
                    write_selection(span=keys[int(event[1]) - 1])
                elif event[0] == "click" or event in (("key", "right"), ("key", "enter"), ("key", " ")):
                    write_selection(span=keys[(keys.index(selection[1]) + 1) % len(keys)])
                elif event == ("key", "left"):
                    write_selection(span=keys[(keys.index(selection[1]) - 1) % len(keys)])
    return 0


