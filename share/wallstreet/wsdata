def demo_movers():
    """Invented quotes that drift a little every minute, same for all panes."""
    rnd = random.Random(int(time.time() // 60))
    rows_ = []
    for sym, name, base in DEMO_STOCKS:
        pct = rnd.gauss(0, 3.2)
        last = base * (1 + pct / 100)
        rows_.append({"symbol": sym, "name": name, "lastSalePrice": "$%.2f" % last,
                      "lastSaleChange": "%+.2f" % (last - base), "change": "%+.2f%%" % pct,
                      "deltaIndicator": "up" if pct >= 0 else "down", "_pct": pct})
    by = sorted(rows_, key=lambda r: r["_pct"])
    table = lambda rs: {"table": {"rows": [{k: v for k, v in r.items() if k != "_pct"}
                                            for r in rs]}}
    return {"MostActiveByDollarVolume": table(rows_[:10]),
            "Nasdaq100Movers": table(rows_[10:18]),
            "MostAdvanced": table([r for r in by[::-1] if r["_pct"] > 0][:8]),
            "MostDeclined": table([r for r in by if r["_pct"] < 0][:8])}


def term_size():
    """Size of the terminal, also when stdout is a pipe or a $(...) capture."""
    for fd in (2, 0, 1):
        try:
            return os.get_terminal_size(fd)
        except OSError:
            continue
    return shutil.get_terminal_size((80, 24))


def cache_dir():
    """A directory only this user can write to.  Not under /tmp: a shared
    temporary directory would let another local user plant a symlink."""
    base = os.environ.get("XDG_CACHE_HOME")
    if not base:
        home = os.path.expanduser("~")
        base = os.path.join(home, "Library", "Caches") if sys.platform == "darwin" \
            else os.path.join(home, ".cache")
    path = os.path.join(base, "wallstreet")
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise SystemExit("wsdata: refusing to use cache directory %s" % path)
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


CACHE = cache_dir()

# Only plain web requests: no file://, ftp:// or anything else
OPENER = urllib.request.OpenerDirector()
for _h in (urllib.request.HTTPHandler, urllib.request.HTTPSHandler,
           urllib.request.HTTPDefaultErrorHandler,
           urllib.request.HTTPErrorProcessor):
    OPENER.add_handler(_h())


class _Redirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        check_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


OPENER.add_handler(_Redirect())


def check_url(url):
    """Refuse anything that is not a web address of a public host.  Feed
    contents decide which pictures are fetched, so they are not trusted."""
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise ValueError("refusing URL %r" % url)
    for info in socket.getaddrinfo(parts.hostname, None):
        ip = ipaddress.ip_address(info[4][0].split("%")[0])
        if not ip.is_global:
            raise ValueError("refusing non-public host %r" % parts.hostname)
    return url


def clean(text):
    """Remote text without control characters, so that a feed or a company
    name cannot send escape sequences to the terminal."""
    return "".join(ch if unicodedata.category(ch)[0] != "C" else " "
                   for ch in str(text))
COLORS = {"red": 31, "green": 32, "yellow": 33, "blue": 34,
          "magenta": 35, "cyan": 36, "white": 37}


def fetch(url, timeout=15):
    req = urllib.request.Request(check_url(url), headers={
        "User-Agent": UA, "Accept": "application/json, text/xml, */*"})
    with OPENER.open(req, timeout=timeout) as r:
        data = r.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError("response too large")
    return data


def cached(name, ttl, producer):
    """Return producer() as bytes, reusing a copy younger than ttl seconds.
    A stale copy is better than nothing when the network is down."""
    path = os.path.join(CACHE, name)
    try:
        if time.time() - os.path.getmtime(path) < ttl:
            with open(path, "rb") as f:
                return f.read()
    except OSError:
        pass
    try:
        data = producer()
        fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=".tmp-")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, path)
        return data
    except Exception:
        try:
            with open(path, "rb") as f:
                return f.read()
        except OSError:
            return b""


