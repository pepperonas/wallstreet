def rows(section):
    try:
        return [{k: clean(v) for k, v in r.items()}
                for r in movers()[section]["table"]["rows"]]
    except Exception:
        return []


def feed_urls():
    urls = []
    try:
        with open(os.path.join(HERE, "newsboat.urls")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    urls.append(line.split()[0])
    except OSError:
        pass
    return urls


def feeds():
    """Parsed feeds as a list of (title, picture-url-or-None)."""
    if DEMO:
        return [[title, None] for title in DEMO_HEADLINES]

    def produce():
        items = []
        for url in feed_urls():
            try:
                root = ET.fromstring(fetch(url))
            except Exception:
                continue
            for item in root.iter("item"):
                title = clean(item.findtext("title") or "").strip()
                pic = None
                for el in item.iter():
                    u = el.attrib.get("url", "")
                    if re.match(r"https?://", u) and re.search(r"\.jpe?g(\?|$)", u):
                        pic = u
                        break
                if title:
                    items.append([title, pic])
        if not items:
            raise RuntimeError("no feed reachable")
        return json.dumps(items).encode()
    try:
        return json.loads(cached("feeds.json", 300, produce))
    except Exception:
        return []


def cmd_table():
    cols = term_size().columns
    sections = (("MOST ACTIVE", "MostActiveByDollarVolume"),
                ("INDEX MOVERS" if DEMO else "NASDAQ-100 MOVERS", "Nasdaq100Movers"),
                ("ADVANCERS", "MostAdvanced"),
                ("DECLINERS", "MostDeclined"))
    out = []
    for title, key in sections:
        data = rows(key)
        if not data:
            continue
        out.append("\033[1;33m%s\033[0m" % title)
        out.append("\033[90m%s\033[0m" % ("-" * (cols - 1)))
        name_w = max(8, cols - 42)
        for r in data:
            pct = r.get("change", "")
            try:
                pct = "%+.2f%%" % float(pct.replace("%", "").replace(",", ""))
            except ValueError:
                pass
            down = r.get("deltaIndicator") == "down" or pct.startswith("-")
            c = "31" if down else "32"
            out.append("\033[1;34m%-6s\033[0m %-*s \033[1;35m%10s\033[0m "
                       "\033[1;%sm%10s %9s\033[0m" % (
                           r.get("symbol", "")[:6], name_w,
                           r.get("name", "")[:name_w],
                           r.get("lastSalePrice", "").lstrip("$")[:10],
                           c, r.get("lastSaleChange", "")[:10], pct[:9]))
        out.append("")
    if not out:
        out = ["\033[33mNo market data available right now.\033[0m"]
    # Never print more than fits: the top of the table is what matters
    lines = term_size().lines
    out = out[:max(3, lines - 1)]
    # A section that lost all its rows to the cut would be a bare heading
    while len(out) > 3 and (out[-1] == "" or out[-1].startswith(("\033[90m", "\033[1;33m"))):
        out.pop()
    print("\n".join(out).rstrip("\n"))


def percent(row):
    """The row's change in percent as a number, or None."""
    try:
        return float(row.get("change", "").replace("%", "").replace(",", ""))
    except ValueError:
        return None


def cmd_movers(direction):
    """One line of gainers or losers: every symbol once, only the asked direction."""
    up = direction == "up"
    parts, seen = [], set()
    for r in rows("MostAdvanced" if up else "MostDeclined") + rows("Nasdaq100Movers"):
        pct, sym = percent(r), r.get("symbol", "")
        if pct is None or pct == 0 or (pct > 0) != up or sym in seen:
            continue
        seen.add(sym)
        parts.append("%s %s %+.2f%%" % (sym, r.get("lastSalePrice", "").lstrip("$"), pct))
    print(" ... ".join(parts))


def cmd_headlines():
    seen = set()
    for title, _ in feeds():
        if title not in seen:
            seen.add(title)
            print(title)


# ---------------------------------------------------------------- selection
#
# The quote table and the chart are two processes in two panes.  What is
# selected travels through one small file in the cache directory.

SPANS = (("1d", "1D"), ("1m", "1M"), ("3m", "3M"), ("ytd", "YTD"), ("1y", "1Y"))
SPAN_KEYS = [key for key, _ in SPANS]
OPEN, CLOSE = 9 * 60 + 30, 16 * 60       # the regular session in minutes of the New York day


def span_days(span, now=None):
    """How many days back a span reaches; 0 for the trading day."""
    now = time.time() if now is None else now
    if span == "ytd":
        # from the first trading day of the year, as chart sites count it; the change
        # is then measured against that day's close like in every other span
        return time.gmtime(now).tm_yday - 1
    return {"1d": 0, "1m": 31, "3m": 92, "1y": 366}[span]


def selection_path():
    return os.path.join(CACHE, "selection-demo.json" if DEMO else "selection.json")


def read_selection():
    try:
        with open(selection_path(), encoding="utf-8") as f:
            data = json.load(f)
        symbol = clean(data.get("symbol", ""))[:12]
        span = data.get("span")
        return (symbol if re.fullmatch(r"[A-Za-z0-9.^-]{1,12}", symbol) else "",
                span if span in SPAN_KEYS else "1d")
    except (OSError, ValueError, AttributeError):
        return "", "1d"


def write_selection(symbol=None, span=None):
    old_symbol, old_span = read_selection()
    data = {"symbol": old_symbol if symbol is None else symbol,
            "span": old_span if span is None else span}
    fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, selection_path())


# ------------------------------------------------------------------ history

def demo_history(symbol, span):
    """An invented course that ends at the symbol's current demo quote."""
    row = next((r for key in ("MostActiveByDollarVolume", "Nasdaq100Movers")
                for r in rows(key) if r.get("symbol") == symbol), None)
    base = next((b for sym, _, b in DEMO_STOCKS if sym == symbol), 100.0)
    name = next((n for sym, n, _ in DEMO_STOCKS if sym == symbol), symbol)
    last = float(row["lastSalePrice"].lstrip("$")) if row else base
    days = span_days(span)
    n = 390 if span == "1d" else max(5, days * 252 // 366)
    start = base if span == "1d" else base * (1 - min(0.3, days / 1220.0))
    rnd = random.Random("%s/%s/%d" % (symbol, span, time.time() // 86400))
    walk, level = [], 0.0
    for _ in range(n):
        level += rnd.gauss(0, 1)
        walk.append(level)
    scale = max(abs(last - start), base * 0.012) / max(1e-9, max(abs(w) for w in walk)) * 0.9
    points = []
    for i, w in enumerate(walk):
        t = i / (n - 1)
        bridge = (w - walk[0] * (1 - t) - walk[-1] * t) * scale   # noise that is zero at both ends
        points.append(start + (last - start) * t + bridge)
    now = time.time()
    if span == "1d":
        labels = ("9:30 AM", "4:00 PM")
    else:
        labels = (time.strftime("%m/%d/%Y", time.localtime(now - days * 86400)),
                  time.strftime("%m/%d/%Y", time.localtime(now)))
    return {"symbol": symbol, "name": name, "points": points, "labels": labels,
            "last": last, "reference": base if span == "1d" else points[0],
            "reference_line": span == "1d", "dim_from": None, "extended": None}


# ------------------------------------------------------- stocks outside the US
#
# Nasdaq only knows what is listed on a US exchange.  Everything else - Volkswagen,
# Mercedes-Benz, Siemens - comes from Lang & Schwarz (ls-tc.de), a German exchange that
# trades some thousand stocks from 8:00 to 23:00 and quotes them in euro.  Such a stock
# is known here by its ISIN, which no ticker symbol can be mistaken for.

ISIN = re.compile(r"[A-Z]{2}[A-Z0-9]{9}[0-9]")
LS = "https://www.ls-tc.de/_rpc/json/"


def is_isin(symbol):
    return bool(ISIN.fullmatch(symbol or ""))


def ls_search(query):
    """What Lang & Schwarz finds for QUERY: [{"symbol" (the ISIN), "label" (the WKN),
    "name", "exchange", "id"}], stocks and funds only."""
    # the key keeps "mercedes benz" and "mercedes-benz" apart: they are answered differently
    key = "ls-search-%s.json" % hashlib.sha1(query.lower().encode()).hexdigest()[:20]
    url = LS + ".lstc/instrument/search/main?localeId=2&q=" + urllib.parse.quote(query, safe="")
    try:
        data = json.loads(cached(key, 3600, lambda: fetch(url)))
    except ValueError:
        return []
    out = []
    for item in data if isinstance(data, list) else []:
        try:
            isin = clean(item.get("isin") or "")
            if item.get("categorySymbol") not in ("STK", "ETF") or not is_isin(isin):
                continue
            out.append({"symbol": isin, "label": clean(item.get("wkn") or "")[:6],
                        "name": clean(item.get("displayname") or isin)[:80],
                        "exchange": "L&S EUR", "id": int(item["instrumentId"])})
        except (AttributeError, KeyError, TypeError, ValueError):
            continue
    return out


def ls_instrument(isin):
    """The entry of one ISIN at Lang & Schwarz, or None."""
    if not is_isin(isin):
        return None
    return next((r for r in ls_search(isin) if r["symbol"] == isin), None)


def label(symbol):
    """What stands in the narrow symbol column: the ticker, or the WKN of an ISIN."""
    if DEMO or not is_isin(symbol):
        return symbol
    found = ls_instrument(symbol)
    return (found and found["label"]) or symbol


def ls_series(isin, series, ttl):
    """([(milliseconds, price)], yesterday's close or None) of one ISIN; series is
    "intraday" (a point a minute) or "history" (a point a day)."""
    found = ls_instrument(isin)
    if not found:
        return [], None
    url = LS + "instrument/chart/dataForInstrument?instrumentId=%d&marketId=1&quotetype=mid&series=%s&localeId=2" % (
        found["id"], series)
    try:
        data = json.loads(cached("ls-%s-%s.json" % (series, isin), ttl, lambda: fetch(url)))
        points = [(int(t), float(v)) for t, v in data["series"][series]["data"] if v is not None]
        previous = next((float(l["value"]) for l in (data.get("info") or {}).get("plotlines") or []
                         if l.get("id") == "previousDay"), None)
    except (ValueError, KeyError, TypeError):
        return [], None
    return points, previous


def berlin(ms, fmt):
    """A moment as the exchange's clock shows it."""
    try:
        import zoneinfo
        zone = zoneinfo.ZoneInfo("Europe/Berlin")
    except Exception:                       # no zone data on this machine: Central European Time
        zone = datetime.timezone(datetime.timedelta(hours=1))
    return datetime.datetime.fromtimestamp(ms / 1000, zone).strftime(fmt)


def ls_quote(isin):
    points, previous = ls_series(isin, "intraday", 60)
    if not points:
        return None
    last = points[-1][1]
    change = last - previous if previous else 0.0
    return {"last": last, "change": change, "pct": change / previous * 100 if previous else 0.0,
            "extended": None, "currency": "EUR"}


def ls_history(isin, span):
    found = ls_instrument(isin)
    if not found:
        return None
    base = {"symbol": isin, "name": found["name"], "dim_from": None, "extended": None, "currency": "EUR"}
    if span == "1d":
        points, previous = ls_series(isin, "intraday", 60)
        if len(points) < 2:
            return None
        return dict(base, points=[v for _, v in points], last=points[-1][1], reference=previous,
                    reference_line=previous is not None,
                    labels=(berlin(points[0][0], "%H:%M"), berlin(points[-1][0], "%H:%M")))
    days, _ = ls_series(isin, "history", 3600)
    start = (time.time() - span_days(span) * 86400) * 1000
    days = [(t, v) for t, v in days if t >= start]
    q = ls_quote(isin)
    if q and days and berlin(days[-1][0], "%Y%m%d") == berlin(time.time() * 1000, "%Y%m%d"):
        days[-1] = (days[-1][0], q["last"])            # today's point follows the day
    elif q and days:
        days.append((int(time.time() * 1000), q["last"]))
    if len(days) < 2:
        return None
    return dict(base, points=[v for _, v in days], last=days[-1][1], reference=days[0][1], reference_line=False,
                labels=(berlin(days[0][0], "%m/%d/%Y"), berlin(days[-1][0], "%m/%d/%Y")))


def number(value):
    """A price or a change as the API writes it: "$1,010.50", "-6.71", "-4.12%"."""
    return float(str(value).replace("$", "").replace(",", "").replace("%", ""))


def nasdaq(symbol, what, name, ttl, query=""):
    """The "data" part of one Nasdaq answer for a symbol; a stock first, then an ETF."""
    for asset in ("stocks", "etf"):
        url = "https://api.nasdaq.com/api/quote/%s/%s?assetclass=%s%s" % (
            urllib.parse.quote(symbol, safe=""), what, asset, query)
        raw = cached("%s-%s-%s.json" % (name, re.sub(r"[^A-Za-z0-9]", "_", symbol), asset),
                     ttl, lambda: fetch(url))
        try:
            data = json.loads(raw)["data"]
        except (ValueError, KeyError, TypeError):
            continue
        if data and (what != "chart" or data.get("chart")):
            return data
    return None


def quote(symbol):
    """The day's official quote and, outside the session, the extended-hours one.

    {"last", "change", "pct"} plus "extended": None or {"label", "last", "change", "pct"}.
    After the close Nasdaq moves the session's figures into "secondaryData" and reports the
    after-hours trade as the primary one - which is why the chart must not take the newest
    price for the day's result.
    """
    if is_isin(symbol):
        return ls_quote(symbol)
    data = nasdaq(symbol, "info", "info", 60)
    try:
        def part(block):
            return {"last": number(block["lastSalePrice"]), "change": number(block["netChange"]),
                    "pct": number(block["percentageChange"])}
        primary = part(data["primaryData"])
        secondary = data.get("secondaryData")
        if secondary and secondary.get("lastSalePrice"):
            official = part(secondary)
            official["extended"] = dict(primary, label=clean(data.get("marketStatus") or "extended")[:14].lower())
            return official
        primary["extended"] = None
        return primary
    except (KeyError, TypeError, ValueError):
        return None


def minute_of_day(point):
    """Minutes since midnight in New York; the API writes local time as if it were UTC."""
    t = time.gmtime(point["x"] / 1000)
    return t.tm_hour * 60 + t.tm_min


def day_history(symbol, data):
    """The trading day: the regular session, with after-hours trading behind it."""
    chart = [p for p in data["chart"] if "x" in p and "y" in p]
    session = [p for p in chart if OPEN <= minute_of_day(p) <= CLOSE]
    after = [p for p in chart if minute_of_day(p) > CLOSE]
    if session:
        shown, dim_from = session + after, (len(session) if after else None)
    else:
        shown, dim_from = chart, 0             # before the opening bell there is only pre-market
    if len(shown) < 2:
        return None
    points = [float(p["y"]) for p in shown]
    q = quote(symbol)
    if q:
        last, reference, extended = q["last"], q["last"] - q["change"], q["extended"]
    else:                                      # no quote: show the course without a verdict
        last, reference, extended = points[(dim_from or len(points)) - 1], None, None
    return {"symbol": symbol, "name": clean(data.get("company") or symbol), "points": points,
            "labels": (clean(shown[0]["z"]["dateTime"]), clean(shown[-1]["z"]["dateTime"])),
            "last": last, "reference": reference, "reference_line": reference is not None,
            "dim_from": dim_from, "extended": extended}


def history(symbol, span):
    """Course of one symbol for a span, or None.

    {symbol, name, points, labels, last, reference, reference_line, dim_from, extended}:
    reference is what the change is measured against (None: unknown), dim_from the index
    of the first point outside the regular session.
    """
    if DEMO:
        return demo_history(symbol, span)
    if is_isin(symbol):
        return ls_history(symbol, span)
    try:
        if span == "1d":
            data = nasdaq(symbol, "chart", "chart-1d", 60)
            return day_history(symbol, data) if data else None
        day = lambda t: time.strftime("%Y-%m-%d", time.gmtime(t))
        now = time.time()
        data = nasdaq(symbol, "chart", "chart-" + span, 3600,
                      "&fromdate=%s&todate=%s" % (day(now - span_days(span) * 86400), day(now)))
        if not data:
            return None
        points = [float(p["y"]) for p in data["chart"]]
        labels = [clean(data["chart"][0]["z"]["dateTime"]), clean(data["chart"][-1]["z"]["dateTime"])]
        last = points[-1]
        q = quote(symbol)
        today = time.strftime("%m/%d/%Y", time.gmtime(now - 5 * 3600))
        if q and labels[1] != today:
            # the daily closes end with yesterday: today's price belongs at the right edge
            points.append(q["last"])
            labels[1], last = today, q["last"]
        elif q:
            last = q["last"]
    except (KeyError, TypeError, ValueError, IndexError):
        return None
    if len(points) < 2:
        return None
    return {"symbol": symbol, "name": clean(data.get("company") or symbol), "points": points,
            "labels": tuple(labels), "last": last, "reference": points[0],
            "reference_line": False, "dim_from": None, "extended": None}


# -------------------------------------------------------------------- chart

BRAILLE = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))   # [row][column] of a cell


def plot(points, width, height, low=None, high=None):
    """The course as HEIGHT strings of WIDTH braille characters (2x4 dots per cell).

    LOW and HIGH widen the value range, for a reference line outside the course."""
    dots_w, dots_h = width * 2, height * 4
    low = min(points) if low is None else min(low, min(points))
    high = max(points) if high is None else max(high, max(points))
    spread = (high - low) or 1.0
    ys = []
    for x in range(dots_w):
        # straight lines between the points: 22 daily closes on 180 dots would be stairs
        at = x * (len(points) - 1) / max(1, dots_w - 1)
        i = min(len(points) - 2, int(at))
        value = points[i] + (points[i + 1] - points[i]) * (at - i)
        ys.append(int(round((high - value) / spread * (dots_h - 1))))
    cells = [[0] * width for _ in range(height)]
    for x, y in enumerate(ys):
        prev = ys[x - 1] if x else y
        for dot in range(min(prev, y), max(prev, y) + 1):      # close the gaps of steep moves
            cells[dot // 4][x // 2] |= BRAILLE[dot % 4][x % 2]
    return ["".join(chr(0x2800 + c) if c else " " for c in line) for line in cells]


def price(value):
    return "%.2f" % value if abs(value) < 100000 else "%.0f" % value


TAB_ROW = 3            # the line of the chart pane that holds the span tabs, 1-based
TAB_GAP = 2


def tab_cells():
    """Per span the 1-based columns of its tab, as drawn by chart_lines."""
    cells, x = {}, 1
    for key, label in SPANS:
        cells[key] = range(x, x + len(label) + 2)
        x += len(label) + 2 + TAB_GAP
    return cells


def tab_at(x, y):
    """The span whose tab is at cell (x, y) of the chart pane, or None."""
    if y != TAB_ROW:
        return None
    return next((key for key, cells in tab_cells().items() if x in cells), None)


def chart_lines(data, span, cols, lines):
    """The chart pane as a list of at most LINES strings no wider than COLS - 1."""
    width = max(20, cols - 1)
    tabs = (" " * TAB_GAP).join(("\033[7m %s \033[27m" if key == span else " %s ") % label
                                for key, label in SPANS)
    out = []
    if not data:
        symbol = read_selection()[0]
        out.append("\033[1;34m%s\033[0m" % symbol if symbol else "\033[1;33mCHART\033[0m")
        out.append("")                     # keeps the tabs on TAB_ROW, where a click looks for them
        out.append("\033[90m%s\033[0m" % tabs)
        out.append("")
        out.append("\033[33m%s\033[0m" % (
            "No chart data for this symbol right now." if symbol
            else "Select a stock: click a row or use the arrow keys.")[:width])
        return out[:lines]
    reference = data.get("reference")
    change = data["last"] - reference if reference is not None else 0.0
    colour = "32" if change >= 0 else "31"
    name_w = max(0, width - len(data["symbol"]) - 1)
    out.append("\033[1;34m%s\033[0m %s" % (data["symbol"], data["name"][:name_w]))
    shown = price(data["last"]) + (" " + data["currency"] if data.get("currency") else "")
    head, plain = "\033[1;35m%s\033[0m" % shown, shown
    if reference:
        text = " %+.2f  %+.2f%%" % (change, change / reference * 100)
        head, plain = head + "\033[1;%sm%s\033[0m" % (colour, text), plain + text
    extended = data.get("extended")
    if extended:
        text = "  %s %s %+.2f (%+.2f%%)" % (extended["label"], price(extended["last"]),
                                            extended["change"], extended["pct"])
        if len(plain) + len(text) <= width:
            head += "\033[90m%s\033[0m" % text
    out.append(head)
    out.append("\033[90m%s\033[0m" % tabs)
    height = lines - 5
    points = data["points"]
    marked = reference if data.get("reference_line") and reference is not None else None
    low = min(points) if marked is None else min(marked, min(points))
    high = max(points) if marked is None else max(marked, max(points))
    axis = max(len(price(low)), len(price(high))) + 1
    plot_w = width - axis
    if height < 3 or plot_w < 10:
        return out[:lines]
    # the session in the colour of the day's result, trading outside it in grey
    dim_from = data.get("dim_from")
    dim_col = plot_w if dim_from is None else int(dim_from * plot_w / len(points))
    mark_row = None
    if marked is not None:
        mark_row = int(round((high - marked) / ((high - low) or 1.0) * (height * 4 - 1))) // 4
    labels = {0: price(high), height - 1: price(low), height // 2: price((high + low) / 2)}
    if mark_row is not None:
        # the reference takes the place of a neighbouring label instead of crowding it
        for row in (mark_row - 1, mark_row + 1):
            if row in labels and row not in (0, height - 1):
                del labels[row]
        labels[mark_row] = price(marked)
    for i, row in enumerate(plot(points, plot_w, height, low, high)):
        session, rest = row[:dim_col], row[dim_col:]
        if i == mark_row:
            # previous close: a dotted grey line wherever the course leaves room
            dotted = lambda part, c: "".join(
                "\033[90m\u2508\033[%sm" % c if ch == " " else ch for ch in part)
            session, rest = dotted(session, colour), dotted(rest, "90")
        out.append("\033[%sm%s\033[90m%s%*s\033[0m" % (colour, session, rest, axis, labels.get(i, "")))
    left, right = data["labels"]
    gap = max(1, plot_w - len(left) - len(right))
    out.append("\033[90m%s%s%s\033[0m" % (left, " " * gap, right)[:width + 9])
    return out[:lines]


