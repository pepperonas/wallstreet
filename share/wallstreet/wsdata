def demo_movers():
    """Invented quotes that drift a little every minute, same for all panes."""
    rnd = random.Random(int(time.time() // 60))
    rows_ = []
    for sym, name, base in DEMO_STOCKS:
        pct = rnd.gauss(0, 3.2)
        last = base * (1 + pct / 100)
        rows_.append({"symbol": sym, "name": name, "lastSalePrice": "$%.2f" % last,
                      "lastSaleChange": "%+.2f" % (last - base), "change": "%+.2f%%" % pct,
                      "deltaIndicator": "up" if pct >= 0 else "down", "_pct": pct})
    by = sorted(rows_, key=lambda r: r["_pct"])
    table = lambda rs: {"table": {"rows": [{k: v for k, v in r.items() if k != "_pct"}
                                            for r in rs]}}
    return {"MostActiveByDollarVolume": table(rows_[:10]),
            "Nasdaq100Movers": table(rows_[10:18]),
            "MostAdvanced": table([r for r in by[::-1] if r["_pct"] > 0][:8]),
            "MostDeclined": table([r for r in by if r["_pct"] < 0][:8])}


def term_size():
    """Size of the terminal, also when stdout is a pipe or a $(...) capture."""
    for fd in (2, 0, 1):
        try:
            return os.get_terminal_size(fd)
        except OSError:
            continue
    return shutil.get_terminal_size((80, 24))


def cache_dir():
    """A directory only this user can write to.  Not under /tmp: a shared
    temporary directory would let another local user plant a symlink."""
    base = os.environ.get("XDG_CACHE_HOME")
    if not base:
        home = os.path.expanduser("~")
        base = os.path.join(home, "Library", "Caches") if sys.platform == "darwin" \
            else os.path.join(home, ".cache")
    path = os.path.join(base, "wallstreet")
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise SystemExit("wsdata: refusing to use cache directory %s" % path)
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


CACHE = cache_dir()

# Only plain web requests: no file://, ftp:// or anything else
OPENER = urllib.request.OpenerDirector()
for _h in (urllib.request.HTTPHandler, urllib.request.HTTPSHandler,
           urllib.request.HTTPDefaultErrorHandler,
           urllib.request.HTTPErrorProcessor):
    OPENER.add_handler(_h())


class _Redirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        check_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


OPENER.add_handler(_Redirect())


def check_url(url):
    """Refuse anything that is not a web address of a public host.  Feed
    contents decide which pictures are fetched, so they are not trusted."""
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise ValueError("refusing URL %r" % url)
    for info in socket.getaddrinfo(parts.hostname, None):
        ip = ipaddress.ip_address(info[4][0].split("%")[0])
        if not ip.is_global:
            raise ValueError("refusing non-public host %r" % parts.hostname)
    return url


def clean(text):
    """Remote text without control characters, so that a feed or a company
    name cannot send escape sequences to the terminal."""
    return "".join(ch if unicodedata.category(ch)[0] != "C" else " "
                   for ch in str(text))
COLORS = {"red": 31, "green": 32, "yellow": 33, "blue": 34,
          "magenta": 35, "cyan": 36, "white": 37}


def fetch(url, timeout=15):
    req = urllib.request.Request(check_url(url), headers={
        "User-Agent": UA, "Accept": "application/json, text/xml, */*"})
    with OPENER.open(req, timeout=timeout) as r:
        data = r.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError("response too large")
    return data


def cached(name, ttl, producer):
    """Return producer() as bytes, reusing a copy younger than ttl seconds.
    A stale copy is better than nothing when the network is down."""
    path = os.path.join(CACHE, name)
    try:
        if time.time() - os.path.getmtime(path) < ttl:
            with open(path, "rb") as f:
                return f.read()
    except OSError:
        pass
    try:
        data = producer()
        fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=".tmp-")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, path)
        return data
    except Exception:
        try:
            with open(path, "rb") as f:
                return f.read()
        except OSError:
            return b""


def movers():
    if DEMO:
        return demo_movers()
    raw = cached("movers.json", 55, lambda: fetch(MOVERS_URL))
    try:
        return json.loads(raw)["data"]["STOCKS"]
    except Exception:
        return {}


def rows(section):
    try:
        return [{k: clean(v) for k, v in r.items()}
                for r in movers()[section]["table"]["rows"]]
    except Exception:
        return []


def feed_urls():
    urls = []
    try:
        with open(os.path.join(HERE, "newsboat.urls")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    urls.append(line.split()[0])
    except OSError:
        pass
    return urls


def feeds():
    """Parsed feeds as a list of (title, picture-url-or-None)."""
    if DEMO:
        return [[title, None] for title in DEMO_HEADLINES]

    def produce():
        items = []
        for url in feed_urls():
            try:
                root = ET.fromstring(fetch(url))
            except Exception:
                continue
            for item in root.iter("item"):
                title = clean(item.findtext("title") or "").strip()
                pic = None
                for el in item.iter():
                    u = el.attrib.get("url", "")
                    if re.match(r"https?://", u) and re.search(r"\.jpe?g(\?|$)", u):
                        pic = u
                        break
                if title:
                    items.append([title, pic])
        if not items:
            raise RuntimeError("no feed reachable")
        return json.dumps(items).encode()
    try:
        return json.loads(cached("feeds.json", 300, produce))
    except Exception:
        return []


def cmd_table():
    cols = term_size().columns
    sections = (("MOST ACTIVE", "MostActiveByDollarVolume"),
                ("INDEX MOVERS" if DEMO else "NASDAQ-100 MOVERS", "Nasdaq100Movers"),
                ("ADVANCERS", "MostAdvanced"),
                ("DECLINERS", "MostDeclined"))
    out = []
    for title, key in sections:
        data = rows(key)
        if not data:
            continue
        out.append("\033[1;33m%s\033[0m" % title)
        out.append("\033[90m%s\033[0m" % ("-" * (cols - 1)))
        name_w = max(8, cols - 42)
        for r in data:
            pct = r.get("change", "")
            try:
                pct = "%+.2f%%" % float(pct.replace("%", "").replace(",", ""))
            except ValueError:
                pass
            down = r.get("deltaIndicator") == "down" or pct.startswith("-")
            c = "31" if down else "32"
            out.append("\033[1;34m%-6s\033[0m %-*s \033[1;35m%10s\033[0m "
                       "\033[1;%sm%10s %9s\033[0m" % (
                           r.get("symbol", "")[:6], name_w,
                           r.get("name", "")[:name_w],
                           r.get("lastSalePrice", "").lstrip("$")[:10],
                           c, r.get("lastSaleChange", "")[:10], pct[:9]))
        out.append("")
    if not out:
        out = ["\033[33mNo market data available right now.\033[0m"]
    # Never print more than fits: the top of the table is what matters
    lines = term_size().lines
    out = out[:max(3, lines - 1)]
    # A section that lost all its rows to the cut would be a bare heading
    while len(out) > 3 and (out[-1] == "" or out[-1].startswith(("\033[90m", "\033[1;33m"))):
        out.pop()
    print("\n".join(out).rstrip("\n"))


def percent(row):
    """The row's change in percent as a number, or None."""
    try:
        return float(row.get("change", "").replace("%", "").replace(",", ""))
    except ValueError:
        return None


def cmd_movers(direction):
    """One line of gainers or losers: every symbol once, only the asked direction."""
    up = direction == "up"
    parts, seen = [], set()
    for r in rows("MostAdvanced" if up else "MostDeclined") + rows("Nasdaq100Movers"):
        pct, sym = percent(r), r.get("symbol", "")
        if pct is None or pct == 0 or (pct > 0) != up or sym in seen:
            continue
        seen.add(sym)
        parts.append("%s %s %+.2f%%" % (sym, r.get("lastSalePrice", "").lstrip("$"), pct))
    print(" ... ".join(parts))


def cmd_headlines():
    seen = set()
    for title, _ in feeds():
        if title not in seen:
            seen.add(title)
            print(title)


def cmd_demofeed():
    """A local RSS file of the invented headlines, for the feed reader."""
    from xml.sax.saxutils import escape
    now = time.time()
    items = "".join(
        "<item><title>%s</title><link>https://example.com/%d</link>"
        "<guid>demo-%d</guid><pubDate>%s</pubDate>"
        "<description>%s.</description></item>" % (
            escape(t), i, i,
            time.strftime("%a, %d %b %Y %H:%M:%S +0000", time.gmtime(now - i * 1740)),
            escape(t))
        for i, t in enumerate(DEMO_HEADLINES))
    feed = os.path.join(CACHE, "demo-feed.xml")
    with open(feed, "w", encoding="utf-8") as f:
        f.write('<?xml version="1.0" encoding="UTF-8"?><rss version="2.0"><channel>'
                "<title>Wall Street Wire (demo)</title><link>https://example.com/</link>"
                "<description>Invented headlines</description>%s</channel></rss>" % items)
    urls = os.path.join(CACHE, "demo.urls")
    with open(urls, "w", encoding="utf-8") as f:
        f.write("file://%s\n" % feed)
    print(urls)
    return 0


def cmd_image():
    if DEMO:
        print(os.path.join(HERE, "demo.jpg"))
        return 0
    pics = sorted({p for _, p in feeds() if p})
    random.shuffle(pics)
    for url in pics[:5]:
        name = "img-%08x.jpg" % (zlib.crc32(url.encode()) & 0xffffffff)
        data = cached(name, 86400, lambda: fetch(url))
        if data:
            print(os.path.join(CACHE, name))
            return 0
    return 1


def cmd_marquee(color, delay, text):
    text = re.sub(r"\s+", " ", clean(text)).strip()
    if not text:
        return 1
    code = COLORS.get(color, 37)
    delay = float(delay)
    cols = max(10, term_size().columns - 1)
    band = " " * cols + text + " " * cols
    try:
        sys.stdout.write("\033[?25l")
        for i in range(len(band) - cols + 1):
            cols_now = max(10, term_size().columns - 1)
            sys.stdout.write("\r\033[1;%dm%s\033[0m\033[K" % (
                code, band[i:i + cols][:cols_now]))
            sys.stdout.flush()
            time.sleep(delay)
    finally:
        sys.stdout.write("\033[?25h\r")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "table":
        return cmd_table()
    if cmd == "movers" and len(argv) > 2:
        return cmd_movers(argv[2])
    if cmd == "headlines":
        return cmd_headlines()
    if cmd == "image":
        return cmd_image()
    if cmd == "demofeed":
        return cmd_demofeed()
    if cmd == "cachedir":
        print(CACHE)
        return 0
    if cmd == "marquee" and len(argv) > 4:
        return cmd_marquee(argv[2], argv[3], argv[4])
    sys.stderr.write(__doc__ or "usage: wsdata table|movers|headlines|image|marquee\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(130)
