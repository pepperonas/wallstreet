PKG=wallstreet
WSDATA="$(dirname "$0")/../../share/$PKG/wsdata"
trap "pkill -9 -f lib/$PKG/ >/dev/null 2>&1; exit" HUP INT QUIT TERM

while true; do
	out=$("$WSDATA" table)
	clear
	printf '%s\n' "$out"
	sleep 60
done
