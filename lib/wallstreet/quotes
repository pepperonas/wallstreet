PKG=wallstreet
WSDATA="$(dirname "$0")/../../share/$PKG/wsdata"
# Ctrl-C in any pane ends the show: close the window all widgets live in
quit() {
	[ -n "$TMUX_PANE" ] && tmux kill-window -t "$TMUX_PANE" >/dev/null 2>&1
	exit 0
}
trap quit INT QUIT TERM

# Redraw every minute, and at once when the pane changes its size
size=
age=60
while true; do
	now=$(stty size 2>/dev/null)
	if [ "$now" != "$size" ] || [ "$age" -ge 60 ]; then
		size=$now
		age=0
		out=$("$WSDATA" table)
		clear
		printf '%s\n' "$out"
	fi
	sleep 1
	age=$((age + 1))
done
