# Licensed under the Apache License, Version 2.0; see LICENSE.

PKG=wallstreet
WSDATA="$(dirname "$0")/../../share/$PKG/wsdata"
trap "pkill -9 -f lib/$PKG/ >/dev/null 2>&1; exit" HUP INT QUIT TERM

command -v img2txt >/dev/null 2>&1 || exit 1
while true; do
	f=$("$WSDATA" image) || { sleep 10; continue; }
	clear
	img2txt -W "$(tput cols)" "$f"
	sleep 10
done
