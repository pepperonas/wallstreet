PKG="wallstreet"
widget_dir="$(cd "$(dirname "$0")/../lib/$PKG" && pwd)"

case "$1" in
	-h|--help)
		exec man $PKG
	;;
esac

if [ -z "$TMUX" ]; then
	# Not in a tmux session: start one, with
	# byobu if it's found, else with plain tmux
	if command -v byobu >/dev/null 2>&1; then
		tmux_launcher=byobu
	else
		tmux_launcher=tmux
	fi
	$tmux_launcher new-session -d -s $PKG "bash"
	$tmux_launcher send-keys -t $PKG "WALLSTREET_OWN_SESSION=1 $0; exit"
	$tmux_launcher send-keys -t $PKG Enter
	exec $tmux_launcher attach-session -t $PKG
	exit 1
fi

cleanup() {
	trap - EXIT HUP INT QUIT TERM
	pkill -9 -f "lib/$PKG/" >/dev/null 2>&1
	# Only take the session down if this script created it
	[ -n "$WALLSTREET_OWN_SESSION" ] && tmux kill-session -t $PKG >/dev/null 2>&1
	exit 0
}
trap cleanup EXIT HUP INT QUIT TERM

# Layout: quotes and the feed reader on top, three tickers and a picture below
win=$(tmux new-window -P -F '#{window_id}' -n $PKG "$widget_dir/quotes") || exit 1
tmux split-window -v -t $win.0 "$widget_dir/ticker +" \; \
	split-window -v -t $win.1 "$widget_dir/ticker -" \; \
	split-window -v -t $win.2 "$widget_dir/ticker topNews" \; \
	split-window -h -t $win.0 "$widget_dir/newsboat" \; \
	split-window -h -t $win.1 "$widget_dir/img2txt" \; \
	send-keys -t $win.1 "Enter" \; \
	resize-pane -t $win.0 -x 80 -y 999999 \
	>/dev/null 2>&1

# Stay around until the last widget is gone
while tmux list-panes -t "$win" -F x 2>/dev/null | grep -q x; do
	sleep 1
done
